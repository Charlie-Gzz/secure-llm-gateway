      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tokens per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
